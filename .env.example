# HemaNet — local development environment template.
#
# Copy to `.env` (which is git-ignored) before running the stack:
#     cp .env.example .env        (or: make env)
#
# Every value below is a LOCAL DEVELOPMENT placeholder. Never put real
# credentials, API keys or production secrets in this file or in git.
# Outside local/ci the backend refuses placeholder ("change-me") credentials.

# Runtime environment: local | ci | staging | pilot | production
APP_ENV=local

# PostgreSQL (local container only). compose.yaml builds the backend's
# DATABASE_URL from these values.
POSTGRES_USER=hemanet
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=hemanet

# Host ports (bound to 127.0.0.1 only)
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Backend logging: LOG_LEVEL = DEBUG | INFO | WARNING | ERROR; LOG_FORMAT = json | console
# (json is required outside local/ci)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Browser origins allowed to call /api/* (comma-separated; https:// only outside local/ci)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker: idle poll interval and heartbeat interval (seconds). /readyz reports
# not ready when no worker heartbeat is newer than READINESS_HEARTBEAT_MAX_AGE_SECONDS.
WORKER_POLL_SECONDS=1
WORKER_HEARTBEAT_SECONDS=30
READINESS_HEARTBEAT_MAX_AGE_SECONDS=120

# Backend tests use a separate, disposable database (name must end in _test).
# `make test` derives it from the values above; set it only to override.
# TEST_DATABASE_URL=postgresql+psycopg://hemanet:change-me-local-only@127.0.0.1:5432/hemanet_test
