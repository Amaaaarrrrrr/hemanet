# HemaNet — local development environment template.
#
# Copy to `.env` (which is git-ignored) before running the stack:
#     cp .env.example .env
#
# Every value below is a LOCAL DEVELOPMENT placeholder. Never put real
# credentials, API keys or production secrets in this file or in git.

# Runtime environment: local | ci | staging | pilot | production
APP_ENV=local

# PostgreSQL (local container only)
POSTGRES_USER=hemanet
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=hemanet

# Host ports (bound to 127.0.0.1 only)
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Placeholder worker heartbeat interval, seconds (E0 placeholder only)
WORKER_HEARTBEAT_SECONDS=30
